PORT=3000
CORS_ORIGIN=http://localhost:5173

# Local dev: leave DATABASE_URL unset (defaults to a local file, no Turso
# account needed). Production: set both to the real Turso database.
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Set only in production (Vercel sends this automatically on cron-triggered
# requests) — unset locally, /api/cron-ingest and /api/cron-instagram-post
# can be curled directly instead of waiting on the schedule.
# CRON_SECRET=

# Leitura operacional: o detalhe de erro em /api/status?detail=true e a
# listagem em /api/admin-broadcasts. Variavel comum (legivel) de proposito:
# o pior caso e expor a mensagem de erro interna de uma fonte, e cobrar um
# giro de token mais um deploy so para diagnosticar foi o que deixou dado
# errado no ar. O que ESCREVE (remover transmissao) usa o CRON_SECRET.
ADMIN_TOKEN=changeme

# Instagram API with Instagram Login (@ondevaipassarfutebol daily poster).
# Leave unset locally and set INSTAGRAM_DRY_RUN=true instead — the poster
# then renders real images and logs what it would post without calling the
# real API. Get both from the app's dashboard (Instagram > API setup with
# Instagram business login): INSTAGRAM_ACCESS_TOKEN from "Generate token"
# next to the account, INSTAGRAM_USER_ID from GET
# https://graph.instagram.com/v25.0/me?fields=user_id using that token.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# PUBLIC_BASE_URL=http://localhost:3000
INSTAGRAM_DRY_RUN=true

# YouTube Data API v3 key — used to find scheduled livestreams on tracked
# broadcasters' channels (CazéTV, ge tv, Canal GOAT, SportyNet, SBT) and
# attach them as broadcasts. console.cloud.google.com: create/select a
# project, enable "YouTube Data API v3", Credentials > Create credentials >
# API key. No OAuth needed, everything read here is public data. Leave
# unset locally — that enrichment step just gets skipped.
# YOUTUBE_API_KEY=
