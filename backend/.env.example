PORT=3000
CORS_ORIGIN=http://localhost:5173

# Local dev: leave DATABASE_URL unset (defaults to a local file, no Turso
# account needed). Production: set both to the real Turso database.
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Set only in production (Vercel sends this automatically on cron-triggered
# requests) — unset locally, /api/cron/ingest can be curled directly instead
# of waiting on the schedule.
# CRON_SECRET=
