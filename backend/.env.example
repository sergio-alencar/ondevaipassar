PORT=3000
CORS_ORIGIN=http://localhost:5173

# Local dev: leave DATABASE_URL unset (defaults to a local file, no Turso
# account needed). Production: set both to the real Turso database.
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Set only in production (Vercel sends this automatically on cron-triggered
# requests) — unset locally, /api/cron-ingest and /api/cron-instagram-post
# can be curled directly instead of waiting on the schedule.
# CRON_SECRET=

# Instagram API with Instagram Login (@ondevaipassarfutebol daily poster).
# Leave unset locally and set INSTAGRAM_DRY_RUN=true instead — the poster
# then renders real images and logs what it would post without calling the
# real API. Get both from the app's dashboard (Instagram > API setup with
# Instagram business login): INSTAGRAM_ACCESS_TOKEN from "Generate token"
# next to the account, INSTAGRAM_USER_ID from GET
# https://graph.instagram.com/v25.0/me?fields=user_id using that token.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# PUBLIC_BASE_URL=http://localhost:3000
INSTAGRAM_DRY_RUN=true
